{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://root.app/content/schemas/choice-task.schema.json",
  "title": "ChoiceTask",
  "description": "Matches Kotlin ChoiceTask(id, prompt, choices[], acceptedChoiceIds[], feedbackCorrect?, feedbackIncorrect?) / Choice(id, text, audioAssetId?). Reused both as a 'choice' Activity's task and inside a Listening activity's EvaluableTask comprehension check. Accepted answers are explicit choice ids, never fuzzy text matching.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "prompt", "choices", "acceptedChoiceIds"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "prompt": { "type": "string", "minLength": 1 },
    "choices": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "audioAssetId": { "type": ["string", "null"], "default": null }
        }
      }
    },
    "acceptedChoiceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "feedbackCorrect": { "type": ["string", "null"], "default": null },
    "feedbackIncorrect": { "type": ["string", "null"], "default": null }
  }
}
