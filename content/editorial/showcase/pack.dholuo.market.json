choice","task":{"acceptedChoiceIds":["c1"],"choices":[{"id":"c1","text":"Rech and rabolo"},{"id":"c2","text":"Bando and alot"},{"id":"c3","text":"Makati and tong'"}],"feedbackCorrect":"Right: fish and bananas.","feedbackIncorrect":"Look again at what he bought.","id":"check-task","prompt":"What did Otieno buy?"}},{"audioAssetId":null,"comprehension":{"kind":"choice_task","task":{"acceptedChoiceIds":["c1"],"choices":[{"id":"c1","text":"An gi pesa"},{"id":"c2","text":"Adwaro chiemo"},{"id":"c3","text":"Erokamano"}],"feedbackCorrect":"Correct.","feedbackIncorrect":"Listen again and check the transcript.","id":"listen-comprehension","prompt":"Which line means 'I have money'?"}},"id":"pack.dholuo.market-story-listen","kind":"listening","transcript":"Adwaro chiemo / An gi pesa / Erokamano","translation":"I want to eat / I have money / Thank you","unavailableReason":"There is no genuine recording of these lines yet. Root will not stand in a synthetic or unrelated voice, so this listening step opens once a real speaker has recorded it. The story and its question above count on their own."}],"format":"listening","id":"pack.dholuo.market-story","linkedPhraseIds":[],"objective":"Follow Otieno shopping for supper, then answer a question.","prerequisiteLessonIds":["pack.dholuo.market-conversation"],"requiredActivityIds":["pack.dholuo.market-story-n1","pack.dholuo.market-story-s1","pack.dholuo.market-story-n2","pack.dholuo.market-story-s2","pack.dholuo.market-story-n3","pack.dholuo.market-story-s3","pack.dholuo.market-story-n4","pack.dholuo.market-story-s4","pack.dholuo.market-story-check"],"revision":1,"title":"Story: Supper from the market"}],"minReaderVersion":1,"objective":"Introduce yourself, count to five, and shop for food.","phrases":[],"publication":"development","schemaVersion":1,"title":"Names, numbers, and the market","version":1}