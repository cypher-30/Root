{"assets":[],"credits":[{"license":"CC BY-SA 4.0","sourceUrl":"https://en.wikivoyage.org/wiki/Luo_phrasebook","text":"Phrases from Wikivoyage contributors, \"Luo phrasebook\", spelling normalized to dh; native-speaker review pending."}],"id":"pack.dholuo.family","language":{"code":"luo","id":"luo","name":"Dholuo"},"lessons":[{"activities":[{"id":"pack.dholuo.family-conversation-setup","kind":"reflection","prompt":"Akinyi visits her grandmother (dayo) early in the morning."},{"audioAssetId":null,"id":"pack.dholuo.family-conversation-t1","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Akinyi","text":"Oyawore","translation":"Good morning"},{"audioAssetId":null,"id":"pack.dholuo.family-conversation-t2","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Dayo","text":"Oyawore. Idhi nade?","translation":"Good morning. How are you?"},{"audioAssetId":null,"id":"pack.dholuo.family-conversation-t3","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Akinyi","text":"Adhi maber","translation":"I'm fine"},{"audioAssetId":null,"id":"pack.dholuo.family-conversation-t4","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Akinyi","text":"Erokamano","translation":"Thank you"},{"audioAssetId":null,"id":"pack.dholuo.family-conversation-t5","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Dayo","text":"Oriti","translation":"Goodbye"},{"audioAssetId":null,"id":"pack.dholuo.family-conversation-t6","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Akinyi","text":"Wanenre machiegni","translation":"See you soon"},{"id":"pack.dholuo.family-conversation-reply","kind":"choice","task":{"acceptedChoiceIds":["c1"],"choices":[{"id":"c1","text":"Adhi maber"},{"id":"c2","text":"Oriti"},{"id":"c3","text":"Oimore"}],"feedbackCorrect":"Right: Adhi maber — I'm fine.","feedbackIncorrect":"Idhi nade? asks how you are.","id":"reply-task","prompt":"A neighbour asks you \"Idhi nade?\". Which reply fits?"}},{"id":"pack.dholuo.family-conversation-say","kind":"speaking_prompt","prompt":"Greet an elder aloud for the morning, then say goodbye."}],"format":"guided_conversation","id":"pack.dholuo.family-conversation","linkedPhraseIds":[],"objective":"Follow Akinyi visiting her grandmother, then choose the reply to 'How are you?'.","prerequisiteLessonIds":[],"requiredActivityIds":["pack.dholuo.family-conversation-t1","pack.dholuo.family-conversation-t2","pack.dholuo.family-conversation-t3","pack.dholuo.family-conversation-t4","pack.dholuo.family-conversation-t5","pack.dholuo.family-conversation-t6","pack.dholuo.family-conversation-reply"],"revision":1,"title":"Morning at Dayo's"},{"activities":[{"examples":["Idhi nade? (How are you? — how are you going?) → Adhi maber (I'm fine — I go well)","Nindi maber (Sleep well)"],"explanation":"The greeting asks how you are going: idhi (you go), and the reply answers adhi (I go). Maber means well, and also closes the good-night wish. This note covers these phrases only.","id":"pack.dholuo.family-pattern-explain","kind":"pattern_explanation"},{"id":"pack.dholuo.family-pattern-build-1","kind":"ordered_tokens","task":{"acceptedSequences":[["tok2","tok1"]],"feedbackCorrect":"Right: Adhi maber.","feedbackIncorrect":"Start with the I-form, Adhi.","id":"build-1-task","prompt":"Reply that you are fine.","tokens":[{"occurrenceId":"tok1","text":"maber"},{"occurrenceId":"tok2","text":"Adhi"}]}},{"id":"pack.dholuo.family-pattern-build-2","kind":"ordered_tokens","task":{"acceptedSequences":[["tok2","tok1"]],"feedbackCorrect":"Right: Nindi maber.","feedbackIncorrect":"Maber (well) comes last.","id":"build-2-task","prompt":"Wish someone a good night.","tokens":[{"occurrenceId":"tok1","text":"maber"},{"occurrenceId":"tok2","text":"Nindi"}]}}],"format":"pattern_workshop","id":"pack.dholuo.family-pattern","linkedPhraseIds":[],"objective":"See how the greeting and its reply mirror each other, then build both.","prerequisiteLessonIds":["pack.dholuo.family-conversation"],"requiredActivityIds":["pack.dholuo.family-pattern-explain","pack.dholuo.family-pattern-build-1","pack.dholuo.family-pattern-build-2"],"revision":1,"title":"Going well: idhi and adhi"},{"activities":[{"audioAssetId":null,"id":"pack.dholuo.family-story-n1","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Story","text":"In the evening Akinyi's whole family eats together. Her grandfather is called kwaro:","translation":null},{"audioAssetId":null,"id":"pack.dholuo.family-story-s1","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Akinyi","text":"Kwaro","translation":"Grandfather"},{"audioAssetId":null,"id":"pack.dholuo.family-story-n2","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Story","text":"Her grandmother, who greeted her that morning, is dayo:","translation":null},{"audioAssetId":null,"id":"pack.dholuo.family-story-s2","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Akinyi","text":"Dayo","translation":"Grandmother"},{"audioAssetId":null,"id":"pack.dholuo.family-story-n3","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Story","text":"Her little brother's child sits on her lap. A small child is:","translation":null},{"audioAssetId":null,"id":"pack.dholuo.family-story-s3","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Akinyi","text":"Nyathi","translation":"Child"},{"audioAssetId":null,"id":"pack.dholuo.family-story-n4","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Story","text":"When it is late she says goodnight to everyone:","translation":null},{"audioAssetId":null,"id":"pack.dholuo.family-story-s4","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Akinyi","text":"Oimore. Nindi maber","translation":"Good evening. Sleep well"},{"id":"pack.dholuo.family-story-check","kind":"choice","task":{"acceptedChoiceIds":["c1"],"choices":[{"id":"c1","text":"Dayo"},{"id":"c2","text":"Kwaro"},{"id":"c3","text":"Nyathi"}],"feedbackCorrect":"Right: dayo is grandmother.","feedbackIncorrect":"Kwaro is grandfather and nyathi is a child.","id":"check-task","prompt":"What does Akinyi call her grandmother?"}},{"audioAssetId":null,"comprehension":{"kind":"choice_task","task":{"acceptedChoiceIds":["c2"],"choices":[{"id":"c1","text":"Kwaro"},{"id":"c2","text":"Nyathi"},{"id":"c3","text":"Dayo"}],"feedbackCorrect":"Correct.","feedbackIncorrect":"Listen again and check the transcript.","id":"listen-comprehension","prompt":"Which word means child?"}},"id":"pack.dholuo.family-story-listen","kind":"listening","transcript":"Kwaro / Dayo / Nyathi","translation":"Grandfather / Grandmother / Child","unavailableReason":"There is no genuine recording of these lines yet. Root will not stand in a synthetic or unrelated voice, so this listening step opens once a real speaker has recorded it. The story and its question above count on their own."}],"format":"listening","id":"pack.dholuo.family-story","linkedPhraseIds":[],"objective":"Read about Akinyi's family, then answer a question about who is who.","prerequisiteLessonIds":["pack.dholuo.family-conversation"],"requiredActivityIds":["pack.dholuo.family-story-n1","pack.dholuo.family-story-s1","pack.dholuo.family-story-n2","pack.dholuo.family-story-s2","pack.dholuo.family-story-n3","pack.dholuo.family-story-s3","pack.dholuo.family-story-n4","pack.dholuo.family-story-s4","pack.dholuo.family-story-check"],"revision":1,"title":"Story: The family at supper"}],"minReaderVersion":1,"objective":"Greet an elder through the day and name the people in a family.","phrases":[],"publication":"development","schemaVersion":1,"title":"Greetings and family","version":1}