{"assets":[],"credits":[{"license":"CC BY-SA 4.0","sourceUrl":"https://en.wikivoyage.org/wiki/Swahili_phrasebook","text":"Phrases from Wikivoyage contributors, \"Swahili phrasebook\", and Omniglot \"Useful Swahili phrases\"; native-speaker review pending."}],"id":"pack.swahili.meeting","language":{"code":"sw","id":"sw","name":"Swahili"},"lessons":[{"activities":[{"id":"pack.swahili.meeting-conversation-setup","kind":"reflection","prompt":"Amina is new in Mombasa. Her neighbour Juma greets her in the morning."},{"audioAssetId":null,"id":"pack.swahili.meeting-conversation-t1","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Juma","text":"Habari ya asubuhi","translation":"Good morning"},{"audioAssetId":null,"id":"pack.swahili.meeting-conversation-t2","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Amina","text":"Nzuri, asante","translation":"Fine, thank you"},{"audioAssetId":null,"id":"pack.swahili.meeting-conversation-t3","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Juma","text":"Jina lako ni nani?","translation":"What is your name?"},{"audioAssetId":null,"id":"pack.swahili.meeting-conversation-t4","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Amina","text":"Jina langu ni Amina","translation":"My name is Amina"},{"audioAssetId":null,"id":"pack.swahili.meeting-conversation-t5","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Juma","text":"Unatoka wapi?","translation":"Where are you from?"},{"audioAssetId":null,"id":"pack.swahili.meeting-conversation-t6","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Amina","text":"Ninatoka Nairobi","translation":"I'm from Nairobi"},{"audioAssetId":null,"id":"pack.swahili.meeting-conversation-t7","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Juma","text":"Nimefurahi kukutana nawe","translation":"Pleased to meet you"},{"id":"pack.swahili.meeting-conversation-reply","kind":"choice","task":{"acceptedChoiceIds":["c1"],"choices":[{"id":"c1","text":"Jina langu ni …"},{"id":"c2","text":"Ninatoka …"},{"id":"c3","text":"Kwaheri"}],"feedbackCorrect":"Right: Jina langu ni … (My name is …).","feedbackIncorrect":"Jina lako ni nani? asks for your name.","id":"reply-task","prompt":"Someone asks you \"Jina lako ni nani?\". Which reply fits?"}},{"id":"pack.swahili.meeting-conversation-say","kind":"speaking_prompt","prompt":"Introduce yourself aloud: your name and where you are from."}],"format":"guided_conversation","id":"pack.swahili.meeting-conversation","linkedPhraseIds":[],"objective":"Follow a first conversation in Mombasa, then choose the reply to a name question.","prerequisiteLessonIds":[],"requiredActivityIds":["pack.swahili.meeting-conversation-t1","pack.swahili.meeting-conversation-t2","pack.swahili.meeting-conversation-t3","pack.swahili.meeting-conversation-t4","pack.swahili.meeting-conversation-t5","pack.swahili.meeting-conversation-t6","pack.swahili.meeting-conversation-t7","pack.swahili.meeting-conversation-reply"],"revision":1,"title":"Amina meets Juma"},{"activities":[{"examples":["Jina lako ni nani? (What is your name?) → Jina langu ni … (My name is …)","Asante (Thank you, one person) → Asanteni (Thank you, more than one person)","Hujambo (Hello, one person) → Hamjambo (Hello, more than one person)"],"explanation":"Jina (name) stays the same; lako means your and langu means my. Separately, several greetings change when you speak to more than one person.","id":"pack.swahili.meeting-pattern-explain","kind":"pattern_explanation"},{"id":"pack.swahili.meeting-pattern-build-1","kind":"ordered_tokens","task":{"acceptedSequences":[["tok3","tok4","tok1","tok2"]],"feedbackCorrect":"Right: Jina langu ni Amina.","feedbackIncorrect":"Start with Jina, then my (langu).","id":"build-1-task","prompt":"Build \"My name is Amina\".","tokens":[{"occurrenceId":"tok1","text":"ni"},{"occurrenceId":"tok2","text":"Amina"},{"occurrenceId":"tok3","text":"Jina"},{"occurrenceId":"tok4","text":"langu"}]}},{"id":"pack.swahili.meeting-pattern-build-2","kind":"ordered_tokens","task":{"acceptedSequences":[["tok4","tok2","tok3","tok1"]],"feedbackCorrect":"Right: Jina lako ni nani?","feedbackIncorrect":"Use lako (your) and end with nani? (who?).","id":"build-2-task","prompt":"Now ask someone their name.","tokens":[{"occurrenceId":"tok1","text":"nani?"},{"occurrenceId":"tok2","text":"lako"},{"occurrenceId":"tok3","text":"ni"},{"occurrenceId":"tok4","text":"Jina"}]}}],"format":"pattern_workshop","id":"pack.swahili.meeting-pattern","linkedPhraseIds":[],"objective":"See how 'your name' and 'my name' differ by one word, and how thanks change for a group.","prerequisiteLessonIds":["pack.swahili.meeting-conversation"],"requiredActivityIds":["pack.swahili.meeting-pattern-explain","pack.swahili.meeting-pattern-build-1","pack.swahili.meeting-pattern-build-2"],"revision":1,"title":"Your and my: lako and langu"},{"activities":[{"audioAssetId":null,"id":"pack.swahili.meeting-story-n1","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Story","text":"Amina joins an evening class. The teacher welcomes everyone:","translation":null},{"audioAssetId":null,"id":"pack.swahili.meeting-story-s1","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Teacher","text":"Karibu","translation":"Welcome"},{"audioAssetId":null,"id":"pack.swahili.meeting-story-n2","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Story","text":"Amina tells the class why she is there:","translation":null},{"audioAssetId":null,"id":"pack.swahili.meeting-story-s2","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Amina","text":"Ninajifunza Kiswahili","translation":"I'm learning Swahili"},{"audioAssetId":null,"id":"pack.swahili.meeting-story-n3","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Story","text":"The teacher asks a long question, and Amina is lost. She says:","translation":null},{"audioAssetId":null,"id":"pack.swahili.meeting-story-s3","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Amina","text":"Samahani. Sielewi","translation":"Sorry. I don't understand"},{"audioAssetId":null,"id":"pack.swahili.meeting-story-n4","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Story","text":"At the end she thanks the teacher and leaves:","translation":null},{"audioAssetId":null,"id":"pack.swahili.meeting-story-s4","kind":"dialogue_turn","linkedPhraseId":null,"speaker":"Amina","text":"Asante. Kwaheri","translation":"Thank you. Goodbye"},{"id":"pack.swahili.meeting-story-check","kind":"choice","task":{"acceptedChoiceIds":["c1"],"choices":[{"id":"c1","text":"Sielewi"},{"id":"c2","text":"Karibu"},{"id":"c3","text":"Kwaheri"}],"feedbackCorrect":"Right: Sielewi means I don't understand.","feedbackIncorrect":"Look at what Amina said when she was lost.","id":"check-task","prompt":"What did Amina say when she didn't follow the question?"}},{"audioAssetId":null,"comprehension":{"kind":"choice_task","task":{"acceptedChoiceIds":["c2"],"choices":[{"id":"c1","text":"Sielewi"},{"id":"c2","text":"Ninajifunza Kiswahili"},{"id":"c3","text":"Karibu"}],"feedbackCorrect":"Correct.","feedbackIncorrect":"Listen again and check the transcript.","id":"listen-comprehension","prompt":"Which line means 'I'm learning Swahili'?"}},"id":"pack.swahili.meeting-story-listen","kind":"listening","transcript":"Karibu / Ninajifunza Kiswahili / Sielewi","translation":"Welcome / I'm learning Swahili / I don't understand","unavailableReason":"There is no genuine recording of these lines yet. Root will not stand in a synthetic or unrelated voice, so this listening step opens once a real speaker has recorded it. The story and its question above count on their own."}],"format":"listening","id":"pack.swahili.meeting-story","linkedPhraseIds":[],"objective":"Read about Amina's first Swahili lesson, then answer a question about it.","prerequisiteLessonIds":["pack.swahili.meeting-conversation"],"requiredActivityIds":["pack.swahili.meeting-story-n1","pack.swahili.meeting-story-s1","pack.swahili.meeting-story-n2","pack.swahili.meeting-story-s2","pack.swahili.meeting-story-n3","pack.swahili.meeting-story-s3","pack.swahili.meeting-story-n4","pack.swahili.meeting-story-s4","pack.swahili.meeting-story-check"],"revision":1,"title":"Story: Amina's first class"}],"minReaderVersion":1,"objective":"Greet someone, trade names and home towns, and say when you don't understand.","phrases":[],"publication":"development","schemaVersion":1,"title":"Hello, who are you?","version":1}