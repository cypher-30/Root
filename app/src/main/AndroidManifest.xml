<?xml version="1.0" encoding="utf-8"?>
<!--
     Root's manifest is intentionally small: one launcher Activity, one FileProvider
     (for the sharing feature's temporary image URIs), one home-screen widget
     receiver. There is no application backend, so there are no other components,
     services, or cleartext-traffic exceptions to declare.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- RevenueCat's Test Store needs no network for purchases themselves, but the SDK's
         own init/analytics calls do. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".RootApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Root"
        android:supportsRtl="true">
        <!-- Backup is disabled: uninstalling removes local practice data, and there
             is no server-side copy to restore from (see README's privacy section). -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.sharedfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <!-- Grants only the app's own cache/shared directory (see shared_paths.xml)
                 read access to the share-sheet target; nothing else is exposed. -->
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/shared_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Root">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
